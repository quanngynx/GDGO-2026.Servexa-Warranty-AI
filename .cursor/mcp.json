{
  "mcpServers": {
    "better-t-stack": {
      "command": "pnpm",
      "args": [
        "dlx",
        "create-better-t-stack@latest",
        "mcp"
      ]
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/sse"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "typeui": {
      "serverUrl": "https://mcp.typeui.sh"
    }
  }
}
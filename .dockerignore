# Docker build context exclusions
# Both server and web Dockerfiles build from repo root:
#   docker build -f apps/server/Dockerfile -t servexa-server .
#   docker build -f apps/web/Dockerfile    -t servexa-web .

.git
.github
**/.turbo
**/.next
**/dist
**/coverage
**/node_modules
**/.env
**/.env.*

# Apps not needed by either Dockerfile (keep package.json for pnpm frozen-lockfile)
# Note: apps/web and apps/server are NOT excluded — both have Dockerfiles.
apps/fumadocs
!apps/fumadocs/package.json
apps/ai-services
# P0A builds the FastAPI image from the repository root. Re-include its runtime
# sources while the server/web Dockerfiles still copy only their explicit paths.
!apps/ai-services/
!apps/ai-services/**
apps/ai-services/.venv
apps/ai-services/.pytest_cache
apps/ai-services/**/__pycache__
apps/ai-services/tests
apps/ai-services/logs
apps/ai-services/.env

# Docs, tests, and local tooling
documents
**/*.md
!packages/**/README.md
**/__tests__
**/*.test.ts
**/*.spec.ts
**/vitest.config.ts

# Database local secrets and compose (runtime uses env / orchestrator secrets)
packages/db/secrets
packages/db/docker-compose*.yml

# Large or non-runtime assets
**/*.log
**/.cursor
**/.claude
**/.agents
**/.gemini
**/.postman
.docker-deploy-test*
postman
secrets
.mcp.json
bts.jsonc
buf.yaml

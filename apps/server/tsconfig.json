{
  "extends": "@servexa-warranty-ai/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "outDir": "dist",
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/core/infra/prisma/generated/browser.ts",
    "src/core/infra/prisma/generated/internal/prismaNamespaceBrowser.ts"
  ]
}

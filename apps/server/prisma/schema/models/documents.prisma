model Document {
  id                  String       @id @default(uuid(7))
  title               String
  description         String?
  detailedDescription String?      @map("detailed_description")
  documentType        DocumentType
  filePath            String?      // Đường dẫn file trên server
  originalFileName    String?      // Tên file gốc
  fileSize            Int?         // Kích thước bytes
  mimeType            String?      // MIME type
  checksum            String?      // MD5/SHA256 để kiểm tra integrity
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  createdBy   User       @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdById String
  updatedBy   User?      @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
  ascCenter   AscCenter? @relation(fields: [ascCenterId], references: [id])
  ascCenterId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accessLogs DocumentAccessLog[]
  versions   DocumentFileVersion[]

  @@index([documentType])
  @@index([ascCenterId])
  @@index([deletedAt, createdAt])
  @@index([title])
  @@map("documents")
}

model DocumentFileVersion {
  id               String  @id @default(uuid(7))
  documentId       String
  filePath         String
  originalFileName String
  fileSize         Int?
  mimeType         String?
  checksum         String?

  // Quan hệ
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("DocumentFileVersionCreatedBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([documentId])
  @@map("document_file_versions")
}

model DocumentAccessLog {
  id         String         @id @default(uuid(7))
  documentId String
  userId     String
  action     DocumentAction
  ipAddress  String?
  userAgent  String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([documentId, action])
  @@index([userId, createdAt])
  @@map("document_access_logs")
}

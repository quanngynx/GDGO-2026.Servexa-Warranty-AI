model BroadcastNotification {
  id        String               @id @default(uuid(7))
  title     String
  body      String               @db.Text
  actionUrl String?              @map("action_url")
  icon      String?
  category  NotificationCategory @default(system)
  priority  NotificationPriority @default(normal)
  type      NotificationType_New @default(info) @map("type")

  // Targeting
  targetType    BroadcastTargetType @map("target_type")
  targetRoles   String[]            @map("target_roles")
  targetUsers   String[]            @map("target_users")
  targetCenters String[]            @map("target_centers")

  // Scheduling
  sendImmediately Boolean   @default(true) @map("send_immediately")
  scheduledFor    DateTime? @map("scheduled_for") @db.Timestamptz(3)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)

  // Tracking
  status         BroadcastStatus @default(draft)
  recipientCount Int             @default(0) @map("recipient_count")
  readCount      Int             @default(0) @map("read_count")

  // Meta
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator       User           @relation(fields: [createdBy], references: [id])
  notifications Notification[] @relation("BroadcastNotifications")

  @@index([status, scheduledFor])
  @@index([targetRoles], type: Gin)
  @@index([targetUsers], type: Gin)
  @@index([targetCenters], type: Gin)
  @@map("broadcast_notifications")
}

model Notification {
  id     String @id @default(uuid(7))
  userId String @map("user_id")

  // Source - either template-based or broadcast
  templateCode String? @map("template_code")
  broadcastId  String? @map("broadcast_id")

  title     String
  body      String               @db.Text
  actionUrl String?              @map("action_url")
  icon      String?
  category  NotificationCategory
  priority  NotificationPriority @default(normal)
  type      NotificationType_New @default(info) @map("type")
  metadata  Json?

  // Status
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                   @relation(fields: [userId], references: [id])
  broadcast BroadcastNotification? @relation("BroadcastNotifications", fields: [broadcastId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([userId, category])
  @@index([broadcastId])
  @@map("notifications")
}

model NotificationPreference {
  id              String               @id @default(uuid(7))
  userId          String               @map("user_id")
  category        NotificationCategory
  isEnabled       Boolean              @default(true) @map("is_enabled")
  showPopup       Boolean              @default(true) @map("show_popup")
  playSound       Boolean              @default(false) @map("play_sound")
  allowBroadcasts Boolean              @default(true) @map("allow_broadcasts")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id          String               @id @default(uuid(7))
  code        String               @unique
  name        String
  description String?
  category    NotificationCategory
  title       String
  body        String               @db.Text
  actionUrl   String?
  icon        String?
  color       String?
  priority    NotificationPriority @default(normal)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_templates")
}

# Docker Compose Secrets
# Create these files in ./secrets/ directory for local development

# secrets/postgres_user.txt
langchain

# secrets/postgres_password.txt
your_secure_password_here

# Google Cloud Secrets (for Cloud Run)
# Create these secrets using:
# gcloud secrets create ai-postgres-host --data-file=-
# gcloud secrets create ai-postgres-user --data-file=-
# gcloud secrets create ai-postgres-password --data-file=-
# gcloud secrets create ai-redis-url --data-file=-

# Example values:
# ai-postgres-host: cloudsql.c.PROJECT_ID.internal (or your Cloud SQL instance)
# ai-postgres-user: langchain
# ai-postgres-password: your_secure_password
# ai-redis-url: redis://redis-instance:6379/0

{
  "name": "servexa-warranty-ai",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "author": "Nguyễn Minh Quân <nguyenminhquan042004@gmail.com> (https://github.com/quanngynx)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanngynx/servexa-warranty-ai.git"
  },
  "bugs": {
    "url": "https://github.com/quanngynx/servexa-warranty-ai/issues"
  },
  "homepage": "https://github.com/quanngynx/servexa-warranty-ai#readme",
  "keywords": [
    "ci-cd",
    "github-actions",
    "docker",
    "google-cloud-platform",
    "nodejs",
    "typescript",
    "reactjs",
    "langgraph",
    "rag",
    "express",
    "devops"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "p0:check": "node scripts/validate-p0-gate.mjs",
    "p0:gate": "node scripts/validate-p0-gate.mjs --require-closed",
    "p0a:up": "node scripts/p0a.mjs up",
    "p0a:smoke": "node scripts/p0a.mjs smoke",
    "p0a:proof": "node scripts/p0a.mjs proof",
    "p0a:load": "node scripts/p0a.mjs load",
    "p0a:down": "node scripts/p0a.mjs down",
    "p0a:check": "node scripts/p0a.mjs check",
    "p0a:gate": "node scripts/p0a.mjs gate",
    "p0a:bundle": "node scripts/evidence-bundle.mjs p0a",
    "p0a:test": "node --test scripts/validate-p0a-gate.test.mjs scripts/p0a-capacity-profile.test.mjs scripts/evidence-attestation.test.mjs",
    "p1:check": "node scripts/validate-p1-gates.mjs",
    "p1d:proof": "node scripts/p1d.mjs proof",
    "p1d:check": "node scripts/p1d.mjs check",
    "p1d:gate": "node scripts/p1d.mjs gate",
    "p1d:bundle": "node scripts/evidence-bundle.mjs p1d",
    "p1d:test": "node --test scripts/validate-p1-gates.test.mjs scripts/evidence-attestation.test.mjs",
    "p1r:check": "node scripts/p1r.mjs check",
    "p1r:preflight": "node scripts/p1r.mjs preflight",
    "p1r:up": "node scripts/p1r.mjs up",
    "p1r:proof": "node scripts/p1r.mjs proof",
    "p1r:gate": "node scripts/p1r.mjs gate",
    "p1r:test": "node --test scripts/p1r-prerequisites.test.mjs",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:docker-compose": "docker compose -f docker-compose.yml up -d --force-recreate postgres redis",
    "pull:server:docker": "docker compose --env-file .env.production -f docker-compose.prod.yml pull server",
    "dev:server:docker": "docker compose -f docker-compose.prod.yml up -d --force-recreate postgres server",
    "db:push": "turbo -F @servexa-warranty-ai/db db:push",
    "db:studio": "turbo -F @servexa-warranty-ai/db db:studio",
    "db:generate": "turbo -F @servexa-warranty-ai/db db:generate",
    "db:migrate": "turbo -F @servexa-warranty-ai/db db:migrate",
    "db:seed": "turbo -F @servexa-warranty-ai/db db:seed",
    "db:seed:identity-user": "turbo -F @servexa-warranty-ai/db db:seed:identity-user",
    "db:seed:hitl-permissions": "turbo -F @servexa-warranty-ai/db db:seed:hitl-permissions",
    "demo:print-cases": "turbo -F @servexa-warranty-ai/db demo:print-cases",
    "db:start": "turbo -F @servexa-warranty-ai/db db:start",
    "db:watch": "turbo -F @servexa-warranty-ai/db db:watch",
    "db:stop": "turbo -F @servexa-warranty-ai/db db:stop",
    "db:down": "turbo -F @servexa-warranty-ai/db db:down",
    "deploy": "turbo -F @servexa-warranty-ai/infra deploy",
    "destroy": "turbo -F @servexa-warranty-ai/infra destroy"
  },
  "dependencies": {
    "@servexa-warranty-ai/env": "workspace:*",
    "axios": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@servexa-warranty-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "^5"
  }
}

# OWASP-hardened Nginx config TEMPLATE for Servexa Warranty AI web SPA.
# This file is processed by envsubst at container startup to inject
# environment-specific values (e.g., API origin for CSP connect-src).
#
# Variables replaced by envsubst (ONLY these are substituted):
#   ${CSP_CONNECT_SRC}  — extra connect-src origins (e.g., "https://api.servexa.com")
#
# Usage in Dockerfile entrypoint:
#   envsubst '${CSP_CONNECT_SRC}' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf
# By listing ONLY ${CSP_CONNECT_SRC}, Nginx $variables ($remote_addr, etc.) are preserved.

pid        /var/run/nginx.pid;
error_log  /var/log/nginx/error.log warn;

worker_processes  auto;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ── Logging ──────────────────────────────────────────────────────────
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';
    access_log  /var/log/nginx/access.log  main;

    # ── Performance ──────────────────────────────────────────────────────
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;

    # ── Gzip compression ─────────────────────────────────────────────────
    gzip             on;
    gzip_vary        on;
    gzip_proxied     any;
    gzip_comp_level  6;
    gzip_min_length  256;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml
        font/woff2;

    # ── Security: hide server version ────────────────────────────────────
    server_tokens  off;

    # ── Security: upload size limit ──────────────────────────────────────
    client_max_body_size  10m;

    # ── WebSocket upgrade map (must be defined before server block) ──────
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ── Upstream: backend API server ─────────────────────────────────────
    upstream backend {
        server server:3000;
    }

    server {
        listen       8080;
        server_name  _;
        root         /usr/share/nginx/html;
        index        index.html;

        # ── Security: disable directory listings ─────────────────────────
        autoindex  off;

        # ── OWASP Security Headers ──────────────────────────────────────
        # CSP connect-src is configurable via the CSP_CONNECT_SRC env var.
        # Default: 'self' only. Set CSP_CONNECT_SRC to add API origins.
        # Example: CSP_CONNECT_SRC="https://api.servexa.com wss://api.servexa.com"
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

        add_header Strict-Transport-Security   "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options             "DENY" always;
        add_header X-Content-Type-Options      "nosniff" always;
        add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy           "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

        # Remove server info leaked by proxied backends
        proxy_hide_header X-Powered-By;

        # ── Health check endpoint ────────────────────────────────────────
        location = /_health {
            access_log  off;
            add_header Content-Type application/json always;
            return 200 '{"status":"ok"}';
        }

        # ── Reverse proxy: API requests → backend ────────────────────────
        location /api/ {
            proxy_pass         http://backend;
            proxy_http_version 1.1;

            # Standard proxy headers
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            # SSE support (CopilotKit streaming): disable buffering
            proxy_buffering    off;
            proxy_cache        off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;

            # WebSocket upgrade (future-proofing)
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection $connection_upgrade;
        }

        # ── Static assets with content-hash: immutable cache ─────────────
        location /assets/ {
            expires    1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # ── Favicon and static public files ──────────────────────────────
        location ~* \.(ico|svg|png|jpg|jpeg|gif|webp|woff2?|ttf|eot)$ {
            expires    30d;
            add_header Cache-Control "public, max-age=2592000" always;
            add_header X-Content-Type-Options "nosniff" always;
            access_log off;
        }

        # ── SPA routing: all other routes → index.html ───────────────────
        location / {
            try_files $uri $uri/ /index.html;

            # index.html must never be cached (SPA entry point)
            location = /index.html {
                add_header Cache-Control "no-cache, no-store, must-revalidate" always;
                add_header Pragma        "no-cache" always;
                add_header Expires       "0" always;

                # Re-apply security headers for index.html
                add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
                add_header Strict-Transport-Security   "max-age=31536000; includeSubDomains" always;
                add_header X-Frame-Options             "DENY" always;
                add_header X-Content-Type-Options      "nosniff" always;
                add_header Referrer-Policy             "strict-origin-when-cross-origin" always;
                add_header Permissions-Policy           "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;
            }
        }

        # ── Block dotfiles (e.g., .env, .git) ───────────────────────────
        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }

        # ── Custom error pages ───────────────────────────────────────────
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            internal;
        }
    }
}

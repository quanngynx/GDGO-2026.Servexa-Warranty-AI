{
  "name": "@servexa-warranty-ai/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./prisma/models": {
      "default": "./prisma/generated/models.ts"
    },
    "./prisma/enum": {
      "default": "./prisma/generated/enum.ts"
    },
    "./prisma/common-input-types": {
      "default": "./prisma/generated/commonInputTypes.ts"
    },
    "./prisma/client": {
      "default": "./prisma/generated/client.ts"
    },
    "./prisma/browser": {
      "default": "./prisma/generated/browser.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "catalog:",
    "@servexa-warranty-ai/env": "workspace:*",
    "dotenv": "catalog:",
    "ioredis": "^5.10.1",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@servexa-warranty-ai/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "typescript": "^5"
  }
}

{
  "name": "@servexa-warranty-ai/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./prisma/models": {
      "default": "./prisma/generated/models.ts"
    },
    "./prisma/enum": {
      "default": "./prisma/generated/enum.ts"
    },
    "./prisma/common-input-types": {
      "default": "./prisma/generated/commonInputTypes.ts"
    },
    "./prisma/client": {
      "default": "./prisma/generated/client.ts"
    },
    "./prisma/browser": {
      "default": "./prisma/generated/browser.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:identity-user": "tsx src/seeds/run-identity-user.ts",
    "db:seed:hitl-permissions": "tsx src/seeds/run-hitl-permissions.ts",
    "demo:print-cases": "tsx src/scripts/print-demo-cases.ts",
    "db:seed": "tsx src/seeds/run.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:start": "docker compose up -d",
    "db:start:production": "docker compose -f docker-compose.production.yml up -d",
    "db:watch": "docker compose up",
    "db:watch:production": "docker compose -f docker-compose.production.yml up",
    "db:stop": "docker compose stop",
    "db:stop:production": "docker compose -f docker-compose.production.yml stop",
    "db:down": "docker compose down",
    "db:down:production": "docker compose -f docker-compose.production.yml down"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "catalog:",
    "@servexa-warranty-ai/env": "workspace:*",
    "bcrypt": "^5.1.1",
    "dotenv": "catalog:",
    "ioredis": "^5.10.1",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@servexa-warranty-ai/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}

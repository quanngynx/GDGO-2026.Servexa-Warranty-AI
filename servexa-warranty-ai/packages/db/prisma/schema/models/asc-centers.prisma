model AccessoryIssue {
  id                 String               @id @default(uuid())
  issueNumber        String               @unique @map("issue_number")
  ascCenterId        String               @map("asc_center_id")
  issuedToUserId     String               @map("issued_to_user_id")
  issuePurpose       IssuePurpose         @default(repair_case)
  repairCaseId       String?              @map("repair_case_id")
  issueDate          DateTime             @map("issue_date") @db.Date
  expectedReturnDate DateTime?            @map("expected_return_date") @db.Date
  status             AccessoryIssueStatus @default(issued)
  notes              String?
  issuedBy           String               @map("issued_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  items              AccessoryIssueItem[]
  ascCenter          AscCenter            @relation(fields: [ascCenterId], references: [id])
  issuer             User                 @relation("AccessoryIssueCreatedBy", fields: [issuedBy], references: [id])
  issuedToUser       User                 @relation("AccessoryIssueReceivedBy", fields: [issuedToUserId], references: [id])
  repairCase         RepairCase?          @relation(fields: [repairCaseId], references: [id])

  @@index([ascCenterId])
  @@index([status])
  @@index([issuedToUserId])
  @@index([repairCaseId])
  @@map("accessory_issues")
}

model AccessoryIssueItem {
  id               String                   @id @default(uuid())
  issueId          String                   @map("issue_id")
  accessoryId      String                   @map("accessory_id")
  issuedQuantity   Int                      @map("issued_quantity")
  returnedQuantity Int                      @default(0) @map("returned_quantity")
  consumedQuantity Int                      @default(0) @map("consumed_quantity")
  unitPrice        Decimal?                 @map("unit_price") @db.Decimal(10, 2)
  status           AccessoryIssueItemStatus @default(issued)
  accessory        Accessory                @relation(fields: [accessoryId], references: [id])
  issue            AccessoryIssue           @relation(fields: [issueId], references: [id])

  @@map("accessory_issue_items")
}

model AccessoryIsUsedOutsideOfWarranty {
  id           String   @id @default(uuid()) @map("id")
  ascCenterId  String   @map("asc_center_id")
  repairCaseId String   @map("repair_case_id")
  accessoryId  String   @map("accessory_id")
  name         String   @map("name")
  usedQuantity Int      @map("used_quantity")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  taxRate      Decimal  @map("tax_rate") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  remark       String?  @map("remark")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ascCenter  AscCenter  @relation(fields: [ascCenterId], references: [id], onDelete: Cascade)
  repairCase RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)
  accessory  Accessory  @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@index([ascCenterId])
  @@index([repairCaseId])
  @@index([accessoryId])
  @@map("accessory_is_used_outside_of_warranty")
}

model AccessoryRequest {
  id                 String                   @id @default(uuid())
  requestNumber      String                   @unique @map("request_number")
  ascCenterId        String                   @map("asc_center_id")
  repairCaseId       String?                  @map("repair_case_id")
  requestedBy        String                   @map("requested_by")
  requestDate        DateTime                 @map("request_date") @db.Date
  urgency            AccessoryRequestUrgency  @default(normal)
  justification      String?
  status             AccessoryRequestStatus   @default(draft)
  statusRecall       StatusRecall?            @map("status_recall")
  approvedBy         String?                  @map("approved_by")
  approvedDate       DateTime?                @map("approved_date") @db.Date
  rejectionReason    String?                  @map("rejection_reason")
  totalEstimatedCost Decimal?                 @map("total_estimated_cost") @db.Decimal(10, 2)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  items              AccessoryRequestItem[]
  supplyVouchers     AccessorySupplyVoucher[]
  approver           User?                    @relation("AccessoryRequestApprover", fields: [approvedBy], references: [id])
  ascCenter          AscCenter                @relation(fields: [ascCenterId], references: [id])
  requester          User                     @relation("AccessoryRequestRequester", fields: [requestedBy], references: [id])
  repairCase         RepairCase?              @relation(fields: [repairCaseId], references: [id])

  @@index([ascCenterId])
  @@index([status])
  @@index([statusRecall])
  @@index([requestedBy])
  @@map("accessory_requests")
}

model AccessoryRequestItem {
  id                 String                       @id @default(uuid())
  requestId          String                       @map("request_id")
  accessoryId        String                       @map("accessory_id")
  requestedQuantity  Int                          @map("requested_quantity")
  approvedQuantity   Int                          @default(0) @map("approved_quantity")
  fulfilledQuantity  Int                          @default(0) @map("fulfilled_quantity")
  unitPrice          Decimal?                     @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal?                     @map("total_price") @db.Decimal(10, 2)
  notes              String?
  status             AccessoryRequestItemStatus   @default(pending)
  accessory          Accessory                    @relation(fields: [accessoryId], references: [id])
  request            AccessoryRequest             @relation(fields: [requestId], references: [id])
  supplyVoucherItems AccessorySupplyVoucherItem[]

  @@index([requestId])
  @@index([accessoryId])
  @@map("accessory_request_items")
}

model AccessoryStockTransaction {
  id               String               @id @default(uuid())
  accessoryId      String               @map("accessory_id")
  ascCenterId      String?              @map("asc_center_id") // Make optional for warehouse imports
  totalWarehouseId String?              @map("total_warehouse_id")
  transactionType  StockTransactionType @map("transaction_type")
  operation        StockOperation
  quantity         Int
  unitPrice        Decimal?             @map("unit_price") @db.Decimal(10, 2)
  totalValue       Decimal?             @map("total_value") @db.Decimal(10, 2)
  referenceId      String?              @map("reference_id")
  referenceType    String?              @map("reference_type")
  notes            String?
  balanceAfter     Int                  @map("balance_after")
  createdBy        String               @map("created_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  accessory        Accessory            @relation(fields: [accessoryId], references: [id])
  ascCenter        AscCenter?           @relation(fields: [ascCenterId], references: [id]) // Make optional
  creator          User                 @relation(fields: [createdBy], references: [id])
  totalWarehouse   TotalWarehouse?      @relation(fields: [totalWarehouseId], references: [id])

  @@map("accessory_stock_transactions")
}

model AccessoryRetailVoucher {
  id            String                       @id @default(uuid())
  voucherNumber String                       @unique
  customerId    String                       @map("customer_id")
  ascCenterId   String                       @map("asc_center_id")
  createdBy     String?                      @map("created_by")
  notes         String?
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  items         AccessoryRetailVoucherItem[]
  customer      Customer                     @relation("RetailVoucherCustomer", fields: [customerId], references: [id])
  ascCenter     AscCenter                    @relation(fields: [ascCenterId], references: [id])
  creator       User?                        @relation("RetailVoucherCreator", fields: [createdBy], references: [id])

  @@index([ascCenterId, customerId])
  @@index([createdBy])
  @@map("accessory_retail_vouchers")
}

model AccessoryRetailVoucherItem {
  id          String                 @id @default(uuid())
  voucherId   String                 @map("voucher_id")
  accessoryId String                 @map("accessory_id")
  qtyIssued   Int                    @map("qty_issued")
  accessory   Accessory              @relation(fields: [accessoryId], references: [id])
  voucher     AccessoryRetailVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, accessoryId])
  @@index([accessoryId])
  @@map("accessory_retail_voucher_items")
}

model AccessorySupplyVoucher {
  id               String              @id @default(uuid())
  voucherNumber    String              @unique
  ascCenterId      String              @map("asc_center_id")
  totalWarehouseId String?             @map("total_warehouse_id")
  issueDate        DateTime            @map("issue_date") @db.Date
  status           SupplyVoucherStatus @default(issued)
  issuedBy         String              @map("issued_by")
  receivedBy       String?             @map("received_by")
  receivedAt       DateTime?           @map("received_at")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  requestId        String?             @map("request_id")

  items          AccessorySupplyVoucherItem[]
  ascCenter      AscCenter                    @relation(fields: [ascCenterId], references: [id])
  request        AccessoryRequest?            @relation(fields: [requestId], references: [id])
  totalWarehouse TotalWarehouse?              @relation(fields: [totalWarehouseId], references: [id])

  @@index([totalWarehouseId, ascCenterId, issueDate])
  @@map("accessory_supply_vouchers")
}

model AccessorySupplyVoucherItem {
  id              String    @id @default(uuid())
  voucherId       String    @map("voucher_id")
  accessoryId     String    @map("accessory_id")
  qtyIssued       Int       @map("qty_issued")
  requestItemId   String?   @map("request_item_id")
  qtyAccepted     Int?      @map("qty_accepted")
  qtyRejected     Int       @default(0) @map("qty_rejected")
  rejectReason    String?   @map("reject_reason")
  rejectNote      String?   @map("reject_note")
  rejectHandled   Boolean   @default(false) @map("reject_handled")
  rejectHandledBy String?   @map("reject_handled_by")
  rejectHandledAt DateTime? @map("reject_handled_at")

  voucher     AccessorySupplyVoucher @relation(fields: [voucherId], references: [id])
  accessory   Accessory              @relation(fields: [accessoryId], references: [id])
  requestItem AccessoryRequestItem?  @relation(fields: [requestItemId], references: [id])

  @@unique([voucherId, accessoryId])
  @@index([accessoryId])
  @@index([requestItemId])
  @@index([rejectHandled, voucherId])
  @@map("accessory_supply_voucher_items")
}

model AscAccessoryStock {
  id            String    @id @default(uuid())
  ascCenterId   String    @map("asc_center_id")
  accessoryId   String    @map("accessory_id")
  currentStock  Int       @default(0) @map("current_stock")
  reservedStock Int       @default(0) @map("reserved_stock")
  minStockLevel Int       @default(5) @map("min_stock_level")
  maxStockLevel Int       @default(100) @map("max_stock_level")
  lastUpdated   DateTime  @default(now()) @map("last_updated")
  accessory     Accessory @relation(fields: [accessoryId], references: [id])
  ascCenter     AscCenter @relation(fields: [ascCenterId], references: [id])

  // @@unique([ascCenterId, accessoryId])
  @@unique([ascCenterId, accessoryId], name: "ascCenterId_accessoryId")
  @@map("asc_accessory_stock")
}

model AscCenter {
  id                          String                      @id @default(uuid())
  centerName                  String                      @map("center_name")
  centerCode                  String                      @unique @map("center_code")
  companyName                 String?                     @map("company_name")
  region                      String?
  email                       String?
  address                     String?
  wardId                      String?                     @map("ward_id")
  provinceId                  String?                     @map("province_id")
  phone                       String?
  licenseNumber               String?                     @map("license_number")
  status                      AscCenterStatus             @default(active)
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  accessoryIssues             AccessoryIssue[]
  accessoryRequests           AccessoryRequest[]
  stockTransactions           AccessoryStockTransaction[]
  stockLevels                 AscAccessoryStock[]
  AccessorySupplyVouchers     AccessorySupplyVoucher[]
  province                    Province?                   @relation(fields: [provinceId], references: [id])
  ward                        Ward?                       @relation(fields: [wardId], references: [id])
  employees                   Employee[]
  productWarranties           ProductWarranty[]
  purchaseOrders              PurchaseOrder[]
  repairAppointments          RepairAppointment[]
  repairCases                 RepairCase[]
  repairCasesTransferredFrom  RepairCase[]                @relation("RepairCaseTransferredFrom")
  repairCasesTransferredTo    RepairCase[]                @relation("RepairCaseTransferredTo")
  users                       User[]
  warrantyClaims              WarrantyClaim[]
  warrantyCoordinations       WarrantyCoordination[]      @relation("CoordinatorAsc")
  warrantyCoordinationsTarget WarrantyCoordination[]      @relation("TargetAsc")

  customers                        Customer[]                         @relation("CustomerAscCenter")
  documents                        Document[]
  payments                         Payment[]
  AccessoryIsUsedOutsideOfWarranty AccessoryIsUsedOutsideOfWarranty[]
  stocktakes                       AscStocktake[]
  accessoryRetailVouchers          AccessoryRetailVoucher[]

  @@map("asc_centers")
}

model AscStocktake {
  id          String   @id @default(uuid())
  ascCenterId String   @map("asc_center_id")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  ascCenter AscCenter          @relation(fields: [ascCenterId], references: [id])
  creator   User               @relation("AscStocktakeCreator", fields: [createdBy], references: [id])
  items     AscStocktakeItem[]

  @@index([ascCenterId, createdAt])
  @@map("asc_stocktakes")
}

model AscStocktakeItem {
  id          String  @id @default(uuid())
  stocktakeId String  @map("stocktake_id")
  accessoryId String  @map("accessory_id")
  previousQty Int     @map("previous_qty")
  newQty      Int     @map("new_qty")
  deltaQty    Int     @map("delta_qty")
  notes       String?

  stocktake AscStocktake @relation(fields: [stocktakeId], references: [id])
  accessory Accessory    @relation("AscStocktakeItem", fields: [accessoryId], references: [id])

  @@index([stocktakeId])
  @@index([accessoryId])
  @@map("asc_stocktake_items")
}

// ==================== ERROR ACCESSORY (Error parts per repair case) ====================
model ErrorAccessory {
  id              String  @id @default(uuid())
  repairCaseId    String  @map("repair_case_id")
  errorAccessory1 String? @map("error_accessory1")
  errorQty1       Int?    @map("error_qty1")
  errorAccessory2 String? @map("error_accessory2")
  errorQty2       Int?    @map("error_qty2")
  errorAccessory3 String? @map("error_accessory3")
  errorQty3       Int?    @map("error_qty3")
  errorAccessory4 String? @map("error_accessory4")
  errorQty4       Int?    @map("error_qty4")
  errorAccessory5 String? @map("error_accessory5")
  errorQty5       Int?    @map("error_qty5")

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  @@index([repairCaseId])
  @@map("error_accessory")
}

model Payment {
  id                String        @id @default(uuid())
  paymentNumber     String?       @map("payment_number")
  repairCaseId      String        @map("repair_case_id")
  caseNumber        String        @map("case_number")
  status            PaymentStatus @default(pending)
  ascCenterId       String        @map("asc_center_id")
  totalCost         Decimal       @default(0) @map("total_cost") @db.Decimal(10, 2)
  // Extended breakdown fields for reporting
  laborOrInspection Decimal       @default(0) @map("labor_or_inspection") @db.Decimal(10, 2)
  shippingCost      Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  distanceFee       Decimal       @default(0) @map("distance_fee") @db.Decimal(10, 2)
  warrantyForm      WarrantyForm? @map("warranty_form")
  paymentPeriodId   String?       @map("payment_period_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  changedBy         String?       @map("changed_by")
  changedAt         DateTime?     @map("changed_at")

  // Relations
  repairCase    RepairCase     @relation(fields: [repairCaseId], references: [id])
  ascCenter     AscCenter      @relation(fields: [ascCenterId], references: [id])
  paymentPeriod PaymentPeriod? @relation(fields: [paymentPeriodId], references: [id])

  @@index([repairCaseId])
  @@index([ascCenterId])
  @@index([paymentPeriodId])
  @@map("payments")
}

// New table for grouping payments by period
model PaymentPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  payments Payment[]

  @@map("payment_periods")
}

model ProductWarranty {
  id                String                @id @default(uuid())
  modelId           String                @map("model_id")
  serialNumber      String                @map("serial_number")
  customerName      String?               @map("customer_name")
  customerPhone     String?               @map("customer_phone")
  customerEmail     String?               @map("customer_email")
  customerAddress   String?               @map("customer_address")
  purchaseDate      DateTime              @map("purchase_date") @db.Date
  purchaseLocation  String?               @map("purchase_location")
  warrantyStartDate DateTime              @map("warranty_start_date") @db.Date
  warrantyEndDate   DateTime              @map("warranty_end_date") @db.Date
  warrantyPolicyId  String                @map("warranty_policy_id")
  registrationDate  DateTime?             @map("registration_date") @db.Date
  registeredBy      String?               @map("registered_by")
  ascCenterId       String                @map("asc_center_id")
  status            ProductWarrantyStatus @default(active)
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  ascCenter         AscCenter             @relation(fields: [ascCenterId], references: [id])
  model             Model                 @relation(fields: [modelId], references: [id])
  registeredByUser  User?                 @relation(fields: [registeredBy], references: [id])
  warrantyPolicy    WarrantyPolicy        @relation(fields: [warrantyPolicyId], references: [id])
  repairCases       RepairCase[]
  warrantyClaims    WarrantyClaim[]

  @@unique([modelId, serialNumber])
  @@map("product_warranties")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique @map("order_number")
  ascCenterId          String              @map("asc_center_id")
  supplierName         String              @map("supplier_name")
  supplierContact      String?             @map("supplier_contact")
  orderDate            DateTime            @map("order_date") @db.Date
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime?           @map("actual_delivery_date") @db.Date
  status               PurchaseOrderStatus @default(draft)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(10, 2)
  paymentStatus        PaymentStatus       @default(pending)
  notes                String?
  createdBy            String              @map("created_by")
  approvedBy           String?             @map("approved_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  items                PurchaseOrderItem[]
  approver             User?               @relation("PurchaseOrderApprovedBy", fields: [approvedBy], references: [id])
  ascCenter            AscCenter           @relation(fields: [ascCenterId], references: [id])
  creator              User                @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])

  @@index([ascCenterId])
  @@index([status])
  @@index([createdBy])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String         @map("purchase_order_id")
  accessoryId      String         @map("accessory_id")
  orderedQuantity  Int            @map("ordered_quantity")
  receivedQuantity Int            @default(0) @map("received_quantity")
  unitPrice        Decimal        @map("unit_price") @db.Decimal(10, 2)
  totalPrice       Decimal        @map("total_price") @db.Decimal(10, 2)
  deliveryStatus   DeliveryStatus @default(pending)
  accessory        Accessory      @relation(fields: [accessoryId], references: [id])
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model Quotation {
  id                   String          @id @default(uuid())
  repairCaseId         String          @map("repair_case_id")
  quotationNumber      String          @unique @map("quotation_number")
  status               QuotationStatus @default(draft)
  laborCost            Decimal         @default(0) @map("labor_cost") @db.Decimal(10, 2)
  partsCost            Decimal         @default(0) @map("parts_cost") @db.Decimal(10, 2)
  serviceFee           Decimal         @default(0) @map("service_fee") @db.Decimal(10, 2)
  totalCost            Decimal         @default(0) @map("total_cost") @db.Decimal(10, 2)
  discountAmount       Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount          Decimal         @default(0) @map("final_amount") @db.Decimal(10, 2)
  description          String?
  notes                String?
  validUntil           DateTime?       @map("valid_until") @db.Date
  createdBy            String          @map("created_by")
  approvedBy           String?         @map("approved_by")
  rejectedBy           String?         @map("rejected_by")
  rejectionReason      String?         @map("rejection_reason")
  sentToCustomerDate   DateTime?       @map("sent_to_customer_date") @db.Date
  customerResponseDate DateTime?       @map("customer_response_date") @db.Date
  customerNotes        String?         @map("customer_notes")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  approver             User?           @relation("QuotationApprovedBy", fields: [approvedBy], references: [id])
  creator              User            @relation("QuotationCreatedBy", fields: [createdBy], references: [id])
  rejector             User?           @relation("QuotationRejectedBy", fields: [rejectedBy], references: [id])
  repairCase           RepairCase      @relation(fields: [repairCaseId], references: [id])

  @@index([repairCaseId])
  @@index([status])
  @@index([quotationNumber])
  @@map("quotations")
}

// Model lưu trữ phiếu thu hồi sản phẩm đổi mới chung cho nhiều phiếu sửa chữa
model ProductReplacementRecall {
  id           String   @id @default(uuid())
  recallNumber String   @unique @map("recall_number") // Số phiếu thu hồi, format: THDM-YYYYMMDD-XXXX
  createdBy    String   @map("created_by")
  notes        String? // Ghi chú khi tạo phiếu thu hồi
  totalCases   Int      @default(0) @map("total_cases") // Số lượng phiếu sửa chữa trong phiếu thu hồi này
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Quan hệ với các phiếu sửa chữa được thu hồi
  repairCases ProductReplacementRecallItem[]

  // Quan hệ với User
  creator User @relation("ProductReplacementRecallCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([createdAt])
  @@map("product_replacement_recalls")
}

// Bảng trung gian liên kết ProductReplacementRecall với RepairCase
model ProductReplacementRecallItem {
  id           String   @id @default(uuid())
  recallId     String   @map("recall_id")
  repairCaseId String   @map("repair_case_id")
  createdAt    DateTime @default(now()) @map("created_at")

  recall     ProductReplacementRecall @relation(fields: [recallId], references: [id], onDelete: Cascade)
  repairCase RepairCase               @relation(fields: [repairCaseId], references: [id])

  @@unique([recallId, repairCaseId])
  @@index([recallId])
  @@index([repairCaseId])
  @@map("product_replacement_recall_items")
}

model RepairCase {
  id                               String                             @id @default(uuid())
  caseNumber                       String                             @unique @map("case_number")
  ascCenterId                      String                             @map("asc_center_id")
  areaId                           String?                            @map("area_id")
  customerId                       String                             @map("customer_id")
  status                           RepairCaseStatus                   @default(tiepnhan)
  priority                         RepairCasePriority                 @default(normal)
  modelId                          String?                            @map("model_id")
  serialNumber                     String?                            @map("serial_number")
  purchaseDate                     DateTime?                          @map("purchase_date") @db.Date
  purchaseLocation                 String?                            @map("purchase_location")
  purchaseLocationId               String?                            @map("purchase_location_id")
  purchaseOrderNumber              String?                            @map("purchase_order_number")
  productWarrantyId                String?                            @map("product_warranty_id")
  productNotes                     String?                            @map("product_notes")
  locknlockCaseNumber              String?                            @map("locknlock_case_number")
  warrantyForm                     WarrantyForm?                      @map("warranty_form")
  warrantyServiceType              WarrantyServiceType?               @map("warranty_service_type")
  solutionId                       String?                            @map("solution_id")
  damageDescription                String                             @map("damage_description")
  diagnosis                        String?
  exchangeProduct                  String?                            @map("exchange_product")

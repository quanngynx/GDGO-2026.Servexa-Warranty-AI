  transferRejecter                 User?                              @relation("RepairCaseTransferRejecter", fields: [transferRejectedBy], references: [id])
  transferReceiver                 User?                              @relation("RepairCaseTransferReceiver", fields: [transferReceivedBy], references: [id])
  paymentProcessor                 User?                              @relation("RepairCasePaymentProcessor", fields: [paymentProcessedBy], references: [id])
  paymentApprover                  User?                              @relation("RepairCasePaymentApprover", fields: [paymentApprovedBy], references: [id])
  transferredFromAsc               AscCenter?                         @relation("RepairCaseTransferredFrom", fields: [transferredFromAscId], references: [id])
  transferredToAsc                 AscCenter?                         @relation("RepairCaseTransferredTo", fields: [transferredToAscId], references: [id])
  shippingProvince                 Province?                          @relation("RepairCaseShippingProvince", fields: [shippingProvinceId], references: [id])
  shippingWard                     Ward?                              @relation("RepairCaseShippingWard", fields: [shippingWardId], references: [id])

  errorPhenomena                   RepairCaseErrorPhenomenon[]
  reasons                          RepairCaseReason[]
  waitAccessories                  WaitAccessory[]
  errorAccessories                 ErrorAccessory[]
  payments                         Payment[]
  accessoryIsUsedOutsideOfWarranty AccessoryIsUsedOutsideOfWarranty[]
  productReplacementRecallItems    ProductReplacementRecallItem[]

  @@index([ascCenterId])
  @@index([status])
  @@index([statusRecall])
  @@index([createdBy])
  @@index([customerId])
  @@index([assignedEmployeeId])
  @@index([serialNumber])
  @@index([locknlockCaseNumber])
  @@index([warrantyForm])
  @@index([promisedDeliveryDate])
  @@index([purchaseLocationId])
  @@index([caseNumber]) // Optimize case number prefix searches for generation
  @@index([status, ascCenterId])
  @@index([assignedEmployeeId, status])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([ascCenterId, status, createdAt])
  @@index([shippingProvinceId])
  @@index([shippingWardId])
  @@map("repair_cases")
}

model RepairCaseAccessory {
  id           String     @id @default(uuid())
  repairCaseId String     @map("repair_case_id")
  accessoryId  String     @map("accessory_id")
  quantity     Int
  unitPrice    Decimal?   @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal?   @map("total_price") @db.Decimal(10, 2)
  addedBy      String     @map("added_by")
  addedAt      DateTime   @default(now()) @map("added_at")
  accessory    Accessory  @relation(fields: [accessoryId], references: [id])
  addedByUser  User       @relation("RepairCaseAccessoryAddedBy", fields: [addedBy], references: [id])
  repairCase   RepairCase @relation(fields: [repairCaseId], references: [id])

  @@map("repair_case_accessories")
}

model RepairCaseErrorPhenomenon {
  id                String   @id @default(uuid())
  repairCaseId      String   @map("repair_case_id")
  errorPhenomenonId String   @map("error_phenomenon_id")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")

  repairCase      RepairCase      @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)
  errorPhenomenon ErrorPhenomenon @relation(fields: [errorPhenomenonId], references: [id])
  creator         User            @relation("RepairCaseErrorPhenomenonCreatedBy", fields: [createdBy], references: [id])

  @@unique([repairCaseId, errorPhenomenonId])
  @@index([repairCaseId])
  @@index([errorPhenomenonId])
  @@map("repair_case_error_phenomena")
}

model RepairCaseFieldHistory {
  id            String   @id @default(uuid())
  repairCaseId  String   @map("repair_case_id")
  fieldName     String   @map("field_name")
  fieldLabel    String?  @map("field_label") // Vietnamese field name for display
  previousValue String?  @map("previous_value") // JSON string for complex values
  newValue      String?  @map("new_value") // JSON string for complex values
  changeType    String   @default("update") @map("change_type") // update, create, delete
  changedBy     String   @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  reason        String? // Change reason if provided
  metadata      String? // Additional context as JSON

  // Relations
  changedByUser User       @relation("RepairCaseFieldHistoryChangedBy", fields: [changedBy], references: [id])
  repairCase    RepairCase @relation(fields: [repairCaseId], references: [id])

  @@index([repairCaseId])
  @@index([fieldName])
  @@index([changedBy])
  @@index([changedAt])
  @@index([repairCaseId, changedAt])
  @@index([repairCaseId, fieldName])
  @@map("repair_case_field_history")
}

model RepairCaseImage {
  id               String              @id @default(uuid())
  repairCaseId     String              @map("repair_case_id")
  imageType        RepairCaseImageType @map("image_type")
  imagePath        String              @map("image_path")
  originalFilename String?             @map("original_filename")
  fileSize         Int?                @map("file_size")
  mimeType         String?             @map("mime_type")
  description      String?
  uploadedBy       String              @map("uploaded_by")
  uploadedAt       DateTime            @default(now()) @map("uploaded_at")
  repairCase       RepairCase          @relation(fields: [repairCaseId], references: [id])
  uploader         User                @relation(fields: [uploadedBy], references: [id])

  @@index([repairCaseId, imageType])
  @@map("repair_case_images")
}

model RepairCaseReason {
  id           String     @id @default(uuid())
  repairCaseId String     @map("repair_case_id")
  reasonId     String     @map("reason_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String     @map("created_by")
  repairCase   RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)
  reason       Reason     @relation(fields: [reasonId], references: [id])
  creator      User       @relation("RepairCaseReasonCreatedBy", fields: [createdBy], references: [id])

  @@unique([repairCaseId, reasonId])
  @@index([repairCaseId])
  @@index([reasonId])
  @@map("repair_case_reasons")
}

model RepairCaseStatusHistory {
  id             String            @id @default(uuid())
  repairCaseId   String            @map("repair_case_id")
  previousStatus RepairCaseStatus? @map("previous_status")
  newStatus      RepairCaseStatus  @map("new_status")
  changedBy      String            @map("changed_by")
  reason         String?
  notes          String?
  metadata       String?
  changedAt      DateTime          @default(now()) @map("changed_at")
  changedByUser  User              @relation(fields: [changedBy], references: [id])
  repairCase     RepairCase        @relation(fields: [repairCaseId], references: [id])

  @@index([repairCaseId])
  @@index([newStatus])
  @@index([changedBy])
  @@index([changedAt])
  @@index([repairCaseId, changedAt])
  @@map("repair_case_status_history")
}

// ==================== WAIT ACCESSORY (Waiting parts per repair case) ====================
model WaitAccessory {
  id             String  @id @default(uuid())
  repairCaseId   String  @map("repair_case_id")
  waitAccessory1 String? @map("wait_accessory1")
  waitQty1       Int?    @map("wait_qty1")
  waitAccessory2 String? @map("wait_accessory2")
  waitQty2       Int?    @map("wait_qty2")
  waitAccessory3 String? @map("wait_accessory3")
  waitQty3       Int?    @map("wait_qty3")
  waitAccessory4 String? @map("wait_accessory4")
  waitQty4       Int?    @map("wait_qty4")
  waitAccessory5 String? @map("wait_accessory5")
  waitQty5       Int?    @map("wait_qty5")

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  @@index([repairCaseId])
  @@map("wait_accessory")
}

model WarrantyClaim {
  id                String                 @id @default(uuid())
  claimNumber       String                 @unique @map("claim_number")
  productWarrantyId String                 @map("product_warranty_id")
  repairCaseId      String?                @map("repair_case_id")
  ascCenterId       String                 @map("asc_center_id")
  claimType         WarrantyClaimType      @map("claim_type")
  claimDate         DateTime               @map("claim_date") @db.Date
  issueDescription  String                 @map("issue_description")
  diagnosis         String?
  recommendedAction String?                @map("recommended_action")
  estimatedCost     Decimal?               @map("estimated_cost") @db.Decimal(10, 2)
  status            WarrantyClaimStatus    @default(submitted)
  reviewedBy        String?                @map("reviewed_by")
  reviewDate        DateTime?              @map("review_date") @db.Date
  reviewNotes       String?                @map("review_notes")
  approvalAmount    Decimal?               @map("approval_amount") @db.Decimal(10, 2)
  rejectionReason   String?                @map("rejection_reason")
  completedDate     DateTime?              @map("completed_date") @db.Date
  urgencyLevel      WarrantyClaimUrgency   @default(normal) @map("urgency_level")
  actualCost        Decimal?               @map("actual_cost") @db.Decimal(10, 2)
  completedBy       String?                @map("completed_by")
  createdBy         String                 @map("created_by")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  ascCenter         AscCenter              @relation(fields: [ascCenterId], references: [id])
  completer         User?                  @relation("WarrantyClaimCompleter", fields: [completedBy], references: [id])
  creator           User                   @relation(fields: [createdBy], references: [id])
  productWarranty   ProductWarranty        @relation(fields: [productWarrantyId], references: [id])
  repairCase        RepairCase?            @relation(fields: [repairCaseId], references: [id])
  reviewer          User?                  @relation("WarrantyClaimReviewer", fields: [reviewedBy], references: [id])
  coordinations     WarrantyCoordination[]

  @@index([ascCenterId])
  @@index([status])
  @@index([createdBy])
  @@index([productWarrantyId])
  @@map("warranty_claims")
}

model WarrantyCoordination {
  id               String                       @id @default(uuid())
  warrantyClaimId  String                       @map("warranty_claim_id")
  coordinationType WarrantyCoordinationType     @map("coordination_type")
  coordinatorAscId String                       @map("coordinator_asc_id")
  targetAscId      String?                      @map("target_asc_id")
  message          String
  response         String?
  priority         WarrantyCoordinationPriority @default(normal)
  status           WarrantyCoordinationStatus   @default(pending)
  createdBy        String                       @map("created_by")
  respondedBy      String?                      @map("responded_by")
  createdAt        DateTime                     @default(now()) @map("created_at")
  respondedAt      DateTime?                    @map("responded_at")
  coordinatorAsc   AscCenter                    @relation("CoordinatorAsc", fields: [coordinatorAscId], references: [id])
  creator          User                         @relation("WarrantyCoordinationCreator", fields: [createdBy], references: [id])
  responder        User?                        @relation("WarrantyCoordinationResponder", fields: [respondedBy], references: [id])
  targetAsc        AscCenter?                   @relation("TargetAsc", fields: [targetAscId], references: [id])
  warrantyClaim    WarrantyClaim                @relation(fields: [warrantyClaimId], references: [id])

  @@map("warranty_coordination")
}

# syntax=docker/dockerfile:1.7

# OWASP Node.js Docker: pinned base, monorepo pnpm, dev deps, bind-mount hot reload.
# Build from repo root: docker build -f apps/server/Dockerfile.dev -t servexa-server:dev .
# Run via: docker compose -f .docker/server/docker-compose.dev.yml up --build server

ARG NODE_IMAGE=node:24.16.0-bookworm-slim
ARG NODE_DIGEST=sha256:242549cd46785b480c832479a730f4f2a20865d61ea2e404fdb2a5c3d3b73ecf
ARG PNPM_VERSION=10.28.1

FROM ${NODE_IMAGE}@${NODE_DIGEST} AS base
ARG PNPM_VERSION
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN --mount=type=cache,id=corepack-cache-dev,target=/root/.cache/corepack \
  corepack enable \
  && corepack prepare pnpm@${PNPM_VERSION} --activate \
  && pnpm config set store-dir /pnpm/store
WORKDIR /app

FROM base AS deps-dev
RUN --mount=type=cache,id=apt-deps-dev-cache,target=/var/cache/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    openssl \
    ca-certificates \
    dumb-init \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 1001 nodejs \
  && useradd --uid 1001 --gid nodejs --shell /usr/sbin/nologin --create-home nodejs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN echo "node-linker=hoisted" > .npmrc
COPY apps/server/package.json apps/server/
COPY packages/ai-contracts/package.json packages/ai-contracts/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/env/package.json packages/env/
COPY packages/event-contracts/package.json packages/event-contracts/
COPY packages/proto/package.json packages/proto/
RUN --mount=type=cache,id=pnpm-store-dev,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --filter server...

FROM deps-dev AS development
ENV NODE_ENV=development
ENV NODE_OPTIONS="--experimental-strip-types"
ENV PORT=3000
# Prisma generate only needs a syntactically valid URL at build time.
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
COPY apps/server apps/server
COPY packages/ai-contracts packages/ai-contracts
COPY packages/config packages/config
COPY packages/db packages/db
COPY packages/env packages/env
COPY packages/event-contracts packages/event-contracts
COPY packages/proto packages/proto
COPY --chown=nodejs:nodejs .docker/server/startup.sh /app/.docker/server/startup.sh
RUN chmod +x /app/.docker/server/startup.sh \
  && pnpm --filter @servexa-warranty-ai/db db:generate \
  && mkdir -p apps/server/uploads apps/server/logs \
  && chown -R nodejs:nodejs apps/server/uploads apps/server/logs /app

USER nodejs

WORKDIR /app

EXPOSE 3000 9229

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["node", "-e", "const p=Number(process.env.PORT||3000);fetch(`http://127.0.0.1:${p}/`).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["dumb-init", "--"]
CMD ["/app/.docker/server/startup.sh"]

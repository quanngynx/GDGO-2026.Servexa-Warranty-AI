{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servexa.invalid/schemas/p0a-evidence-v1.json",
  "title": "Servexa P0A evidence registry",
  "type": "object",
  "required": ["schemaVersion", "subjectCommit", "subjectTree", "sourceDigest", "sourceScope", "generatedAt", "scenarioVersion", "records", "manifestSignature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "subjectCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "subjectTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceScope": {
      "type": "object",
      "required": ["id", "version", "manifest", "fileCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "fileCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "workflowRunId": { "type": ["string", "null"] },
    "workflowRunAttempt": { "type": ["string", "null"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenarioVersion": { "type": "string", "minLength": 1 },
    "manifestSignature": {
      "type": "object",
      "required": ["algorithm", "publicKey", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKey": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proofId", "status", "artifacts", "toolVersions", "imageVersions"],
        "properties": {
          "proofId": { "type": "string" },
          "status": { "enum": ["PASSED", "FAILED"] },
          "reason": { "type": ["string", "null"] },
          "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
          "imageVersions": { "type": "object", "additionalProperties": { "type": "string" } },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
